# Aegis configuration template. Copy to .env and fill. Never commit .env.

# Elasticsearch (Ubuntu VM 192.168.56.105)
ES_HOST=http://192.168.56.105:9200
ES_USER=elastic
ES_PASSWORD=

# Local LLM (llama.cpp server, OpenAI-compatible)
LLM_PROVIDER=llamacpp
LLM_MODEL=
LLM_BASE_URL=http://localhost:8080/v1

# App
AEGIS_LOG_LEVEL=INFO
AEGIS_ENV=dev

# Runtime switches
AEGIS_STORE=memory              # memory | es
AEGIS_SAFE_MODE=0               # 1 = pause autonomy + force approvals
AEGIS_REQUIRE_APPROVAL=0        # 1 = human gate on every action
AEGIS_DISABLE_AGENTS=           # e.g. A3,A4
AEGIS_REVOKED_TOOLS=            # e.g. lookup_ip,isolate_host

# Threat intelligence providers (comma list; order = fan-out priority base)
# local | abuseipdb | virustotal | otx   (keys optional per provider)
TI_PROVIDERS=local
VT_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# Vulnerability metadata (separate from IOC TI)
NVD_API_KEY=

# Elastic alert ingestion (adapter polls this index for new alerts)
ES_ALERT_INDEX=aegis-dev-alerts     # or .siem-signals-* for real Elastic Security
ES_POLL_INTERVAL=30                 # seconds between polls
ES_POLL_ENABLED=0                   # 1 = enable background polling
