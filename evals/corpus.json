{
  "version": "2",
  "description": "Aegis evaluation corpus (spec \u00a720). Labels are ground truth; metrics runner compares agent judgments against them. No invented numbers: every metric comes from running this corpus.",
  "scenarios": [
    {
      "id": "tp-encoded-powershell-c2",
      "label": "malicious",
      "expect_investigate": true,
      "expect_injection_flag": false,
      "alert_fields": {
        "host": "win-vm",
        "severity": "high",
        "process": "powershell.exe",
        "parent": "WINWORD.EXE",
        "command_line": "powershell -enc SQBFAFA7AFIA"
      },
      "events": [
        {
          "event_id": "1",
          "channel": "sysmon",
          "action": "ProcessCreate",
          "host": "win-vm",
          "process_name": "WINWORD.EXE",
          "process_pid": "500"
        },
        {
          "event_id": "1",
          "channel": "sysmon",
          "action": "ProcessCreate",
          "host": "win-vm",
          "process_name": "powershell.exe",
          "process_pid": "1000",
          "process_parent": "WINWORD.EXE",
          "command_line": "powershell -enc SQBFAFA7AFIA"
        },
        {
          "event_id": "3",
          "channel": "sysmon",
          "action": "NetworkConnect",
          "host": "win-vm",
          "process_name": "powershell.exe",
          "process_pid": "1000",
          "destination_ip": "185.220.101.4",
          "destination_port": "443"
        },
        {
          "event_id": "11",
          "channel": "sysmon",
          "action": "FileCreate",
          "host": "win-vm",
          "process_name": "powershell.exe",
          "process_pid": "1000",
          "file_path": "C:\\ProgramData\\payload.dll"
        }
      ]
    },
